# 复制本文件为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交到仓库

# Flask 会话签名密钥，请使用随机字符串
# 可用 python3 -c "import secrets; print(secrets.token_hex(32))" 生成
SECRET_KEY=change-me-to-a-random-secret

# 生产 HTTPS 环境必须为 true；仅本地 HTTP 开发时改为 false
SESSION_COOKIE_SECURE=true

# MySQL 数据库连接
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_NAME=photos_of_the_year

# 部署在域名子路径时填写，例如 /photos-of-the-year；根路径部署时留空
APP_BASE_PATH=

# 照片浏览器私有缓存时长（秒），默认30天
PHOTO_CACHE_MAX_AGE=2592000

# 初始化脚本创建的默认账户（deploy/init_db.py 使用）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
USER_USERNAME=user
USER_PASSWORD=change-me
